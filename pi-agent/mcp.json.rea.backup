{
  "mcpServers": {
    "remote": {
      "command": "/Users/cskim/.local/share/remote-gateway/tools/cm/bin/cm",
      "args": [
        "mcp"
      ],
      "env": {
        "CM_POLICY_PATH": "/Users/cskim/.local/share/remote-gateway/config/cm-policy.yaml",
        "CM_HOME": "/Users/cskim/.local/share/remote-gateway"
      },
      "exposure": "direct",
      "description": "사내 원격 SSH/SFTP와 API 조회. tool: list, status, exec, pull, push, scp, api_get, session_record, memory_get, memory_put. 자격증명은 kdbx 안에만 둔다."
    }
  }
}
